{
  "name": "storyboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun node_modules/@tauri-apps/cli/tauri.js dev",
    "build": "bun node_modules/@tauri-apps/cli/tauri.js build --bundles app",
    "dev:web": "bun run build:web && bun web/serve.ts",
    "build:web": "bun run check:web && bun web/build.ts",
    "check:web": "bun node_modules/typescript/bin/tsc --noEmit",
    "test:web": "bun test tests",
    "test": "bun test tests && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/bun": "^1.4.2",
    "typescript": "7.0.2"
  }
}
